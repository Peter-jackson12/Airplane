151,15245],", network call",[15244,15268],[15312,15345],[15270,15345],"Korean SVG text uses system font fallbacks; no font files or external assets are embedd",[15307,15345],"Weather levels and signed paired deltas are rounded independently from tracked evidence",[15309,15345],"Three-seed SD is not a confidence interval; the metrics do not share a quantitative axis",[15535,16177]]},{"path":"tests/test_final_submission_status.py","before_sha256":"ab60d334ec5aba8c57eb3460e00a92ce47c180074594cf04f61012f6f81a9c61","after_sha256":"51ae79cc13cdbf0197c83eaded6ce525624af3dde18d7a5a8064bdcddc8cfc19","pieces":[[0,434],"history",[310,363],"1]\n    # Preserve the dated initial state, but do not make a completed project\n    # read like a to-do list by requiring that history in the current body.",[429,476],"history",[562,606],"history\n    assert \"27/27 분할\" in current and \"1,317 요청 묶음",[547,575],"날씨 유무",[537,575],"전체 수집·전체 행 결합·날씨 모델 비교·제출 정리",[471,496],"2026-09-22",[547,575],[626,1352]]},{"path":"tests/test_join_weather_full_driver.py","before_sha256":"658fcf5d8b7a292a25c3abffacdc62e8e3007dd0f707105a7bc93fa9c11b6eaf","after_sha256":"c9b3c22185593841842cc949532e26044748f3be0b1475f3fff6fc19be35cc0f","pieces":[[0,13396],"# Result evidence remains beside the coverage table; its commands are\n    # now linked to the technical reproduction section rather than repeated.\n    assert '(#join-reproduction)' in section\n    reprodu",[12955,12984],"join-reproductio",[13004,13028],"/details>', 1)[0]",[13391,13436],"reprodu",[13438,13483],"reprodu",[13485,13541]]},{"path":"tests/test_readme_contract.py","before_sha256":"7d2d26d552230f5a2f4b6b81dcae0b59e15836799a50f38aeed8a76fc46d206f","after_sha256":"fe5716b1f565e7fcfb13c330f057d2f6c1c50f37f782c559dfea3c0ffad7b5d2","pieces":[[0,2799],"# Technical reproduction details may be folded from section 7 onward.\n    # The problem, results and interpretation limits must remain unfolded.\n    reader_body = prose.split('<a id=\"7-코드구조와재현\"></a>', 1)[0]\n    assert '<details>' not in reader_body\n    assert '0.598945' in reader_body and '180,332' in reader_body\n    assert '인과 효과' in reader_body and '실측 공개 지연 시간이 아닙니다' in reader_body",[2870,4559]]},{"path":"tests/test_readme_presentation.py","before_sha256":"682e7b27120d48ad0b1f10294a31b340c0edafba63971e767625f7f08a570914","after_sha256":"c29b97e3d96d3391897d590a27608e0e350ca18ae2a3376486e8dbd36e9d20ce","pieces":[[0,2720],"LogLoss', 'ROC-AUC']\n    expected = [\n        (0.5739098053816244, 0.5989451594849345, 0.025035354103310186, True),\n        (0.4481163223494364, 0.4366887714640056, -0.011427550885430774, False),\n        (0.6406182693684818, 0.6729355261382809, 0.032317256769799164, True),\n    ]\n    for row, (off, on, delta, higher) in zip(rows, expected):\n        assert row['off_mean'] == pytest.approx(off)\n        assert row['on_mean'] == pytest.approx(on)\n        assert row['delta_mean'] == pytest.approx(delta)\n        assert row['higher_is_better'] is higher\n        assert row['definition'] == 'weather_on - weather_off'\n        assert row['sd'] > 0 and row['off_sd'] > 0 and row['on_sd'] > 0\n        assert set(row['deltas_by_seed']) == {'42', '1', '7'}\n        assert all(v > 0 if higher else v < 0 for v in row['deltas_by_seed'].values()",[3056,3528],[3549,5647],"\n\ndef test_opening_summary_matches_all_frozen_weather_levels_and_signed_deltas",[1087,1155],"opening = text.split('<a id=\"1-목적과문제정의\"></a>', 1)[0]\n    for count in ('1,000,000행', '255,001행', '706,759행', '180,332행'):\n        assert count in opening\n    assert '`Delay`' in opening and '14개 피처' in opening\n    assert '동일 평가행·동일 시드·동일 외부 폴드' in opening\n    assert 'Macro F1 향상을 확인하지 못했습니다' in opening\n    for row in",[2622,2663],":\n        direction = '↑' if row['higher_is_better'] else '↓'\n        delta = f\"{row['delta_mean']:+.6f}\".replace('-', '−')\n        expected = (f\"| {row['metric']} {direction} | {row['off_mean']:.6f} | \"\n                    f\"**{row['on_mean']:.6f}** | **{delta}** |\")\n        assert expected in opening\n    assert '실측 공개 지연 시간이 아닙니다' in opening\n    assert '인과 효과나 ",[5055,5081],"opening\n    assert '신뢰구간이 아닙니다' in opening\n    assert '<details>' not in opening\n\n\ndef test_current_prose_uses_korean_work_terms_without_translating_identifiers",[1087,1155],"body = text.split('<a id=\"weather-glossary\"></a>', 1)[0]\n    # Code, paths and explicit identifiers are not reader-facing prose.\n    body = re.sub(r'```.*?```', '', body, flags=re.S)\n    body = re.sub(r'`[^`]+`', '', body)\n    body = re.sub(r'\\]\\([^)]+\\)', ']', body)\n    for term in ('shard', 'request group', 'weather-off', 'weather-on', 'paired',\n                 'transport', 'checkpoint', 'manifest', 'latency', 'finalize',\n                 'outer', 'inner', 'resume', 'cache-only', 'fail-closed'):\n        assert not re.search(r'\\b' + re.escape(term) + r'\\b', body, re.I), term\n    for identifier in ('P4_clean', 'P6_fixed', 'P6_clean', 'LightGBM', 'Macro F1",[3464,3488],"  'LogLoss', 'ROC-AUC', 'OOF', 'TE'):\n        assert identifier in text\n\n\ndef test_weather_svg_shows_original_levels_signed_changes_and_distinct_scales():\n",[1415,1447],"'assets/readme/weather_model_comparison.svg",[5218,5254],"text = ' '.join(svg.itertext())\n    for row in",[2622,2663],":\n        assert row['metric'] in text\n        assert f\"{row['off_mean']:.6f}\" in text\n        assert f\"{row['on_mean']:.6f}\" in text\n        assert f\"{row['delta_mean']:+.6f}\" in text\n        assert f\"{row['sd']:.6f}\" in text\n    for phrase in ('180,332행', '10분 공개 지연 가정', '날씨 미사용', '날씨 사용',\n                   '낮을수록 좋음', '척도가 달라', '신뢰구간이 아닙니다'):\n        assert phrase in text\n\n\ndef test_all_five_svg_have_korean_accessible_titles_and_no_external_font_dependency():\n    for filename in builder.FIGURES.values():",[1410,1447],"'assets/readme' / filename",[1451,1501],"attrib['role'] == 'img'\n        assert svg.attrib['aria-labelledby'] == 'title desc'\n        title = svg.find('{http://www.w3.org/2000/svg}title')\n        desc = svg.find('{http://www.w3.org/2000/svg}desc')\n        assert title is not None and re.search('[가-힣]', title.text)\n        assert desc is not None and len(desc.text) > 20\n        raw = ET.tostring(svg, encoding='unicode')\n        assert '@import' not in raw and '@font-face' not in raw and 'url(' not in raw\n\n\n@pytest.mark.parametrize('field', ['filters', 'sources', 'figures'])\ndef test_figure_receipt_rejects_changed_filter_or_asset_contract(tmp_path, monkeypatch, field",[366,411],"if field == 'filters':\n        receipt[field]['calibration']['group'] = 'different_population'\n    else:\n        receipt[field].pop(next(iter(receipt[field])))\n    (tmp_path / 'sources.json').write_text(json.dumps(receipt), encoding='utf-8')\n    monkeypatch.setattr(builder, 'ASSETS', tmp_path)\n    with pytest.raises(ValueError, match='changed'):\n    ",[905,933],"\n\ndef test_all_five_figures_and_receipt_rebuild_byte_for_byte(tmp_path, monkeypatch):\n    # Only the five tracked aggregate inputs are copied. No raw data,\n    # model or network entrypoint is available in this build sandbox.\n    for relative in builder.SOURCES.values():\n        target = tmp_path / relative\n        target.parent.mkdir(parents=True, exist_ok=True)\n        target.write_bytes((ROOT / relative).read_bytes())\n    output = tmp_path / 'assets/readme'\n    monkeypatch.setattr(builder, 'ROOT', tmp_path)\n    monkeypatch.setattr(builder, 'ASSETS', output)\n    builder.build()",[904,937],"for name in [*builder.FIGURES.values(), 'sources.json']:\n        assert (output / name).read_bytes() == (ROOT / 'assets/readme' / name).read_bytes(), name\n"]}],"expected_outputs":{"README.md":"5111cee0aa9e5bd770ea9a0239dbadaac84cd8df442c1bcc2b869cc4f767f39f","assets/readme/calibration_tradeoff.svg":"2ec12168d3dad14c1561c36cb64778852224ddd1a4a2ebd567f6ffac6d8d94fd","assets/readme/date_attribution.svg":"f3862132fff6f3f97fd5a4e4a44d3580bce0c0cc7922aee6fcb8a0030455