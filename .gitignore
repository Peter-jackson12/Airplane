# =====================================
# 데이터 파일 (GitHub 100MB 제한 방지)
# =====================================
data/
*.csv
*.tsv
*.zip
*.parquet

# 실험 결과 표는 크기가 작고 문서의 근거 자료이므로 예외로 추적한다.
# (output/baseline_recovery.csv 는 재측정 수치의 단일 진원지다)
!output/*.csv

# =====================================
# Python / uv 가상환경
# =====================================
.venv/
__pycache__/
*.py[cod]
*$py.class

# =====================================
# 모델 저장 파일 및 대용량 산출물
# =====================================
*.pkl
*.joblib
*.model
*.bin

# Row-level predictions remain local; small diagnostic tables and manifests are tracked.
output/*_oof/
output/*_error_stability.csv.gz
output/pytest_oof_tmp*/

# =====================================
# 에이전트·IDE·운영체제 로컬 설정
# =====================================
.vscode/
.idea/
# 에이전트가 자동 생성하는 사용자별 설정. 저장소 공용 규칙은 AGENTS.md 에 둔다.
.codex/
Thumbs.db
.DS_Store
